		(uuid "50b9bab7-6744-4908-828d-63e8344f196c")
	)
	(text "WS2812 OUTPUTS (5V only): 74HCT2G17 dual buffer (TTL-level inputs) + 330R series, 10k pull-downs keep LEDs quiet when the MCU is off"
		(exclude_from_sim no)
		(at 109.22 205.74 0)
		(effects
