	(text "FANS 1-6: 4-pin PWM on JST-XH. JPx selects VIN (1-2) or 5V (2-3). BSS138DW (dual) = 3V3->5V open-drain PWM shifter, 10k packs = pull-ups. Tach: 10k pull-up, 4.7k series + BAT54S clamp."
		(exclude_from_sim no)
		(at 160.02 20.32 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
